GOAL = (1, 2, 3,
        4, 5, 6,
        7, 8, 0)
MOVES = {
    'U': -3,
    'D': 3,
    'L': -1,
    'R': 1
}
def display(state):
    for i in range(0, 9, 3):
        print(state[i], state[i + 1], state[i + 2])
    print()
def get_neighbors(state):
    neighbors = []
    blank = state.index(0)
    row = blank // 3
    col = blank % 3
    for move, change in MOVES.items():
        new_pos = blank + change
        if move == 'U' and row == 0:
            continue
        if move == 'D' and row == 2:
            continue
        if move == 'L' and col == 0:
            continue
        if move == 'R' and col == 2:
            continue
        new_state = list(state)
        new_state[blank], new_state[new_pos] = \
            new_state[new_pos], new_state[blank]
        neighbors.append((tuple(new_state), move))
    return neighbors
def DFS(start):
    stack = [(start, [])]
    visited = set()
    while stack:
        state, path = stack.pop()
        if state in visited:
            continue
        visited.add(state)
        if state == GOAL:
            return path
        for next_state, move in get_neighbors(state):
            if next_state not in visited:
                stack.append((next_state, path + [move]))
    return None
def depth_limited_search(state, depth, path, visited):
    if state == GOAL:
        return path
    if depth == 0:
        return None
    visited.add(state)
    for next_state, move in get_neighbors(state):
        if next_state not in visited:
            result = depth_limited_search(next_state,depth - 1, path + [move],visited)
            if result is not None:
                return result
    visited.remove(state)
    return None
def IDFS(start, max_depth=30):
    for depth in range(max_depth + 1):
        print("Searching at depth:", depth)
        result = depth_limited_search(start,depth,[],set())
        if result is not None:
            return result
    return None
def solve_puzzle(start, solution):
    state = start
    print("\nInitial State:")
    display(state)
    for move in solution:
        blank = state.index(0)
        for next_state, direction in get_neighbors(state):
            if direction == move:
                state = next_state
                break
        print("Move:", move)
        display(state)
